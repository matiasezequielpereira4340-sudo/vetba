{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build:seo",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/veterinarias-:barrio", "destination": "/veterinarias/:barrio", "permanent": true }
  ],
  "headers": [
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/data.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
    ] }
  ]
}
