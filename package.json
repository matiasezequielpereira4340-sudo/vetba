{
  "name": "vetba",
  "version": "2.0.0",
  "private": true,
  "description": "VetBA - directorio de veterinarias de CABA y GBA. Sitio estatico (index.html + data.json) con paginas SEO generadas.",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build:seo": "node scripts/generar-paginas.mjs",
    "build": "npm run build:seo",
    "normalizar": "node scripts/normalizar-data.mjs",
    "normalizar:check": "node scripts/normalizar-data.mjs --check",
    "dev": "python3 -m http.server 8080"
  }
}
